{
  "manifest_version": 3,
  "name": "UCR Registration Extension",
  "version": "1.0.1",
  "description": "GPA, RMP, and difficulty under Course Delivery on UCR class search, plus a detail modal. Only on registrationssb.ucr.edu.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://registrationssb.ucr.edu/StudentRegistrationSsb/*",
    "https://myclassgrades.com/*",
    "https://api.myclassgrades.com/*",
    "https://www.ratemyprofessors.com/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://registrationssb.ucr.edu/StudentRegistrationSsb/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png",
        "grades-gold.svg",
        "grades-black.svg",
        "rmp-gold.svg",
        "rmp-black.svg",
        "reviews-gold.svg",
        "reviews-black.svg"
      ],
      "matches": ["https://registrationssb.ucr.edu/*"]
    }
  ]
}
